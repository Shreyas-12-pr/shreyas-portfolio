# Supabase project URL and public publishable key (safe for browser + server use).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public publishable key (safe for browser + server use, protected by RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Email address allowed to sign in to the admin dashboard.
ADMIN_EMAIL=your-admin-email@example.com

# Public site URL used for metadata, canonical URLs, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
